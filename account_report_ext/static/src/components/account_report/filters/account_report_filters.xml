<?xml version="1.0" encoding="UTF-8" ?>
<templates>

  <t t-name="account_report_ext.AccountReportFilterAccountTypecs">


    <Dropdown togglerClass="'btn btn-secondary'">



      <t t-set-slot="toggler">
        <i class="fa fa-filter me-1"/>
Account Type Custom:
        <t t-esc="controller.options.name_account_types_cs"/>
      </t>

      <t t-foreach="controller.options.account_types_cs" t-as="AccountTypeCSItem" t-key="AccountTypeCSItem_index">
        <DropdownItem class="{ 'selected': AccountTypeCSItem.selected, 'ps-4': true }" onSelected="() => this.filterAccountTypeCS(AccountTypeCSItem)">
          <t t-esc="AccountTypeCSItem.name"/>
        </DropdownItem>
      </t>


    </Dropdown>
  </t>

  <t t-name="account_report_ext.AccountReportFiltersCustomizable" t-inherit="account_reports.AccountReportFiltersCustomizable" t-inherit-mode="extension">
    <xpath expr="//t[@t-if='hasExtraOptionsFilter']" position="after">
      <t t-if="'filter_account_type_cs' in controller.options">
        <div id="filter_account_type_cs">
          <t t-call="account_report_ext.AccountReportFilterAccountTypecs"/>
        </div>
      </t>
    </xpath>
  </t>

</templates>
